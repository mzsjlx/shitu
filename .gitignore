# Installed dependencies and local runtimes
**/node_modules/
**/.python-packages/
**/__pycache__/
*.py[cod]

# Rebuildable output from the main application and older prototype
**/dist/
/map-base/preview.html

# Local preview processes, browser sessions, and incomplete downloads
**/.local/
**/.playwright-cli/
*.log
*.partial.pmtiles

# Local credentials and environment configuration; keep example templates
.env
.env.*
!.env.example
!.env.sample
!.env.template
*.pem
*.key

# Editor and operating-system state
.idea/
.vscode/
.DS_Store
Thumbs.db
scratch/

# Keep output/ source audits, research snapshots, and reviewed screenshots.
# Some data verification/preparation scripts depend on those project files.
map-base/preview-*.html

# Temporary video frame extraction dumps from research scripts
output/research/**/*_frames/
output/research/**/tmp_frames/
output/research/**/*_intro*/
output/research/**/*_all/
output/research/**/*_menu/
output/research/**/*_end/
output/research/**/*_door/
output/research/**/batch*_inspection/
output/research/**/*.tmp.jpg
output/research/chengdu/*_ticket.jpg
output/research/chengdu/*_26s.jpg
output/research/chengdu/*_40s.jpg
output/research/chengdu/*_100s.jpg
output/research/chengdu/*_bowl_*.jpg
output/research/chengdu/ticket_title.jpg
output/research/chengdu/bozai_frame*.jpg
